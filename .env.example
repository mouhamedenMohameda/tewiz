# --- API ---
NODE_ENV=development
PORT=3000

# --- Database ---
# In dev, this connects through the SSH tunnel to your Contabo VPS:
#   ssh -L 5432:localhost:5432 -L 6379:localhost:6379 root@5.189.153.144
# Then locally it looks like Postgres is on 127.0.0.1:5432.
# Replace YOUR_DB_PASSWORD with the password generated by setup-contabo.sh.
DATABASE_URL=postgres://tewiz:YOUR_DB_PASSWORD@localhost:5432/tewiz

# --- Redis ---
# Also tunneled in dev (see DATABASE_URL).
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# In dev, OTPs are returned in API response and logged instead of sent by SMS.
SMS_PROVIDER=mock

# --- Twilio (later) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Storage ---
# In dev: local disk under apps/api/uploads.
# In prod: MUST be an absolute path OUTSIDE the source tree (e.g.
#   /var/lib/tewiz/uploads), otherwise a `git pull` / rsync / rebuild can
#   wipe all uploaded captain documents and top-up screenshots.
#   Pair with scripts/backup-uploads.sh in a pre-deploy hook.
# In prod (later): swap LocalDiskStorage for R2Storage.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760            # 10 MB raw upload limit
IMAGE_MAX_WIDTH_PX=1600
IMAGE_JPEG_QUALITY=80

# Cloudflare R2 (later)
S3_ENDPOINT=
S3_BUCKET=tewiz-docs
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# --- Backups (scripts/backup-db.sh, ship-wal.sh, setup-pitr.sh) ---
# The API, Postgres, Redis and UPLOAD_DIR all live on ONE Contabo box. A dump
# stored on that same box does not survive losing it, so backup-db.sh REFUSES to
# report success unless at least one of the three off-site targets below is set.
# Setting several is fine — each one configured must succeed.
#
# Option A — S3-compatible object storage (Cloudflare R2, Backblaze B2, Contabo
# Object Storage). Needs the `aws` CLI on the server. R2 is the cheap pick: no
# egress fees, so a restore during an outage costs nothing.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=auto
#
# Option B — rsync over SSH to any second machine you control (another VPS, an
# always-on box at the office). Needs a passwordless key: cron cannot answer a
# password prompt.
BACKUP_SSH_TARGET=
#
# Option C — Google Drive, Dropbox, OneDrive… via rclone. Install it with
#   curl https://rclone.org/install.sh | sudo bash
# then configure the remote once with `rclone config` and put "remote:folder" here.
# See docs/runbook-backup-restore.md for the Drive walkthrough.
#
# ⚠️  Dumps contain phone numbers, NNI, KYC documents and the wallet ledger. On a
#     personal Drive, wrap the remote in an rclone `crypt` remote so Google only
#     holds ciphertext, and point this at the crypt remote — the backup scripts
#     never see the key.
BACKUP_RCLONE_REMOTE=
# Path to rclone.conf. Set this when cron runs as a user whose $HOME differs from
# the one you ran `rclone config` as, or rclone will not find its remotes.
RCLONE_CONFIG=
# Remote retention, in days. OPT-IN: empty means never prune, which fills the
# quota but can never delete your only surviving copies. Object storage (R2/B2)
# is better handled with a bucket lifecycle rule; Drive has none, so set this
# there (e.g. 30) once you trust the setup.
BACKUP_REMOTE_KEEP_DAYS=

# Local dump retention (nightly dumps). Off-site retention is set at the bucket.
KEEP=7
# Where WAL segments are archived before being shipped off-site. The interval of
# the ship-wal cron (5 min, see setup-pitr.sh) is the real RPO.
WAL_ARCHIVE_DIR=/var/backups/tewiz-wal
WAL_KEEP_DAYS=8
# Dev-only escape hatch: lets backup-db.sh succeed with no off-site target.
# Never set this on the production server.
ALLOW_LOCAL_ONLY=

# --- Business config ---
DEFAULT_COMMISSION_BPS=700           # 7.00% in basis points
COLIS_COMMISSION_BPS=1000            # 10.00% in basis points
MIN_BALANCE_TO_GO_ONLINE_KHOUMS=100  # 20 MRU (1 MRU = 5 khoums)
NEGATIVE_BALANCE_FLOOR_KHOUMS=-250   # -50 MRU floor before hard block
HOME_LOCK_DAYS=30
HOME_GPS_TOLERANCE_M=200
GOING_HOME_SESSION_MAX_HOURS=2
GOING_HOME_MAX_PER_DAY=2
GOING_HOME_ARRIVAL_RADIUS_M=500

# --- Observability ---
# Any DB query at/over SLOW_QUERY_MS is logged at WARN with its (parameter-free)
# SQL + duration. HTTP requests at/over SLOW_REQUEST_MS are logged the same way.
# Set either to 0 to disable that logger.
SLOW_QUERY_MS=200
SLOW_REQUEST_MS=1500

# Prometheus exposition — GET /metrics, gated on `Authorization: Bearer <token>`.
# Empty = the endpoint 404s and nothing is scrapeable. The metrics include
# per-zone demand and captain supply (a map of where Tewiz is strong and where it
# is failing), so it is never open by default the way /health is.
# Generate with: openssl rand -hex 32
# See docs/monitoring.md for the Grafana Cloud wiring and the alert rules.
METRICS_TOKEN=
# How often the SQL-derived gauges (fill rate, time-to-match quantiles, per-zone
# demand) are recomputed. This is a load knob, not a freshness knob: the queries
# run against the same Postgres that serves dispatch.
METRICS_REFRESH_MS=30000

# --- Maps ---
# Geocoding uses Nominatim (OpenStreetMap) — free, no API key.
# Tile rendering uses OSM tiles (admin web) / Apple/Google Maps (mobile).
