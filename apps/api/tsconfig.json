{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": "src",
    // Runtime-only: don't emit .d.ts files. pnpm's non-flat
    // node_modules layout otherwise raises "type cannot be named"
    // errors for every Router() definition (see voice-location-api
    // tsconfig for the same fix).
    "declaration": false,
    "sourceMap": false
  },
  // shared-types is consumed as a TS project reference: tsc -b builds it
  // first, the API sees the emitted .d.ts files, and `rootDir: "src"` is
  // no longer violated by imports outside src/.
  "references": [
    { "path": "../../packages/shared-types" }
  ],
  "include": ["src/**/*.ts"]
}
