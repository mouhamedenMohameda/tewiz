{
  // ⚠️ CE FICHIER N'EST PAS CELUI QU'EAS UTILISE.
  //
  // Le projet Expo vit dans apps/mobile, et c'est apps/mobile/eas.json que la
  // CLI lit quand on lance `eas build` ou `eas submit` depuis ce dossier — le
  // seul endroit d'où on les lance. Ce fichier-ci est un vestige de la racine
  // du monorepo.
  //
  // Comment on l'a appris : une configuration de soumission ajoutée ICI (piste
  // "alpha", statut "draft") a été parfaitement ignorée. La soumission est
  // partie sur la piste `internal` en statut `COMPLETED`, et le réglage avait
  // l'air appliqué tout en ne faisant rien.
  //
  // Avant d'éditer quoi que ce soit ici, vérifie que c'est bien ce fichier que
  // tu veux :  cd apps/mobile && cat eas.json
  //
  // À noter : apps/mobile/eas.json est marqué `skip-worktree` dans git (il
  // contient un MAPBOX_DOWNLOAD_TOKEN secret), donc ses modifications locales
  // ne se committent pas d'elles-mêmes.
  "cli": {
    "version": ">= 20.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
