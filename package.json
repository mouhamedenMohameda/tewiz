{
  "name": "tewiz",
  "version": "0.0.1",
  "private": true,
  "description": "Ride-hailing platform for Mauritania",
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @tewiz/api dev",
    "mobile:start": "pnpm -C apps/mobile exec expo start",
    "mobile:start:dev-client": "pnpm -C apps/mobile exec expo start --dev-client --clear",
    "mobile:ios": "pnpm -C apps/mobile exec expo start --ios",
    "mobile:android": "pnpm -C apps/mobile exec expo start --android",
    "db:migrate": "pnpm --filter @tewiz/api migrate",
    "db:migrate:down": "pnpm --filter @tewiz/api migrate:down",
    "tunnel": "ssh -L 5432:localhost:5432 -L 6379:localhost:6379 root@5.189.153.144",
    "tree:update": "bash scripts/update-project-tree.sh",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm -r --parallel --if-present test:watch",
    "typecheck": "pnpm run test && pnpm -r typecheck",
    "build": "pnpm run test && pnpm -r build"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
